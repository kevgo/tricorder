{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/tricorder-hooks/post_write.sh",
            "statusMessage": "Tricorder: running linters...",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
