{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tricorder configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON Schema URL for editor support",
      "type": ["string", "null"]
    },
    "global-fixes": {
      "type": ["array", "null"],
      "items": {
        "$ref": "#/$defs/GlobalFix"
      }
    },
    "global-lints": {
      "type": ["array", "null"],
      "items": {
        "$ref": "#/$defs/GlobalLint"
      }
    },
    "ignore-files": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "applications": {
      "anyOf": [
        {
          "$ref": "#/$defs/Applications"
        },
        {
          "type": "null"
        }
      ]
    },
    "stacks": {
      "type": ["object", "null"],
      "properties": {
        "css": {
          "$ref": "#/$defs/StackConfig"
        },
        "cucumber": {
          "$ref": "#/$defs/StackConfig"
        },
        "go": {
          "$ref": "#/$defs/StackConfig"
        },
        "java": {
          "$ref": "#/$defs/StackConfig"
        },
        "json": {
          "$ref": "#/$defs/StackConfig"
        },
        "jsonc": {
          "$ref": "#/$defs/StackConfig"
        },
        "markdown": {
          "$ref": "#/$defs/StackConfig"
        },
        "python": {
          "$ref": "#/$defs/StackConfig"
        },
        "rust": {
          "$ref": "#/$defs/StackConfig"
        },
        "sql": {
          "$ref": "#/$defs/StackConfig"
        },
        "toml": {
          "$ref": "#/$defs/StackConfig"
        },
        "typescript": {
          "$ref": "#/$defs/StackConfig"
        },
        "unknown": {
          "$ref": "#/$defs/StackConfig"
        },
        "yml": {
          "$ref": "#/$defs/StackConfig"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "GlobalFix": {
      "type": "object",
      "properties": {
        "name": {
          "type": ["string", "null"]
        },
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["command"]
    },
    "GlobalLint": {
      "type": "object",
      "properties": {
        "name": {
          "type": ["string", "null"]
        },
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["command"]
    },
    "Applications": {
      "type": "object",
      "properties": {
        "keep-sorted": {
          "anyOf": [
            {
              "$ref": "#/$defs/Application"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Application": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": ["boolean", "null"]
        },
        "ignore-files": {
          "type": ["array", "null"],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "StackConfig": {
      "type": "object",
      "properties": {
        "lint": {
          "anyOf": [
            {
              "$ref": "#/$defs/StackTools"
            },
            {
              "type": "null"
            }
          ]
        },
        "fix": {
          "anyOf": [
            {
              "$ref": "#/$defs/StackTools"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "StackTools": {
      "type": "object",
      "properties": {
        "add": {
          "type": ["array", "null"],
          "items": {
            "$ref": "#/$defs/StackCommand"
          }
        },
        "replace": {
          "type": ["array", "null"],
          "items": {
            "$ref": "#/$defs/StackCommand"
          }
        }
      },
      "additionalProperties": false
    },
    "StackCommand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": ["name", "command"]
    }
  }
}
